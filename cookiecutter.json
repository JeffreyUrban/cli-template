{
  "project_name": "My CLI Tool",
  "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '-').replace('_', '-') }}",
  "package_name": "{{ cookiecutter.project_slug.replace('-', '_') }}",
  "class_name": "{{ cookiecutter.project_name.title().replace(' ', '').replace('-', '').replace('_', '') }}",
  "project_short_description": "A brief description of what your CLI tool does",
  "author_name": "Your Name",
  "author_email": "(optional)",
  "github_username": "yourusername",
  "python_version": "3.9",
  "license": ["MIT", "Apache-2.0", "BSD-3-Clause", "GPL-3.0", "None"],
  "command_name": "{{ cookiecutter.project_slug }}",
  "_copy_without_render": [
    "*.svg",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.ico",
    "{{cookiecutter.project_slug}}/.github/renovate.json",
    "{{cookiecutter.project_slug}}/.github/workflows/*.yml",
    "{{cookiecutter.project_slug}}/.github/workflows/*.yaml",
    "{{cookiecutter.project_slug}}/.idea/*.iml",
    "{{cookiecutter.project_slug}}/.idea/*.xml",
    "{{cookiecutter.project_slug}}/.vscode/*.json"
  ]
}
